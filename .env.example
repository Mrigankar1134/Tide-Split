# Neon Postgres connection string (paste the pooled URL from the Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# AWS S3 for receipts / bills
AWS_REGION=ap-south-1
S3_BUCKET=tide-split-receipts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Random long string used to sign login sessions (any 32+ chars)
SESSION_SECRET=
